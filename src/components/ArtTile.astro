---
interface Props {
  img: string;
  title: string;
  blurb?: string;
  href?: string;
  badge?: string;
  badgeKind?: 'free' | 'wip';
  tags?: string[];
  dev?: boolean;
  wide?: boolean;
}
const { img, title, blurb, href, badge, badgeKind, tags = [], dev = false, wide = false } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class={`tile${dev ? ' dev' : ''}${wide ? ' wide' : ''}`} href={href}>
  {badge && <span class={`badge ${badgeKind ?? ''}`}>{badge}</span>}
  <img src={`/tiles/${img}`} alt={title} loading="lazy" />
  {tags.length > 0 && (
    <div class="tagrow">
      {tags.map((t) => <span class="thtag">{t}</span>)}
    </div>
  )}
  <div class="t">
    <strong>{title}</strong>
    {blurb && <span class="b">{blurb}</span>}
  </div>
</Tag>

<style>
  * { box-sizing: border-box; }
  .tile {
    position: relative;
    display: block;
    background: var(--card2);
    border: 1px solid var(--hair);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .tile:hover {
    transform: translateY(-4px);
    border-color: var(--acc);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.5);
  }
  .tile.dev { border-style: dashed; }
  img { display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
  .tile.wide img { aspect-ratio: 800 / 375; }
  .badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--acc);
    color: var(--bg);
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 6px;
    letter-spacing: 0.06em;
    z-index: 1;
  }
  .badge.free { background: var(--green); }
  .badge.wip { background: transparent; color: var(--red); border: 1px solid var(--red); }
  .tagrow { position: absolute; bottom: 64px; left: 10px; display: flex; gap: 5px; flex-wrap: wrap; }
  .thtag {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.05em;
    background: rgba(5, 6, 8, 0.82);
    color: var(--dim);
    padding: 2px 7px;
    border-radius: 5px;
    text-transform: uppercase;
  }
  .t {
    padding: 10px 12px 12px;
    font-family: var(--sans);
    color: var(--ink);
    font-size: 13px;
    line-height: 1.4;
    min-height: 58px;
  }
  .t strong { display: block; font-weight: 600; }
  .b { display: block; color: var(--dim); font-size: 12px; margin-top: 2px; }
</style>
