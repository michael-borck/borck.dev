---
import type { Book } from '../data/wall.ts';
interface Props {
  books: Book[];
  title: string;
  blurb: string;
  href: string;
}
const { books, title, blurb, href } = Astro.props;
---

<a class="collage" href={href} aria-label={title}>
  <div class="face">
    <div class="quad">
      {books.map((b) => (
        <img
          src={`/tiles/covers/${b.slug}.webp`}
          alt={b.title}
          title={b.title}
          loading="lazy"
          style={`background:${b.bg ?? 'var(--card2)'}`}
        />
      ))}
    </div>
  </div>
  <div class="t">
    <strong>{title}</strong>
    <span class="b">{blurb}</span>
  </div>
</a>

<style>
  * { box-sizing: border-box; }
  .collage {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--card2);
    border: 1px solid var(--hair);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .collage:hover {
    transform: translateY(-4px);
    border-color: var(--acc);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.5);
  }
  .face { aspect-ratio: 1 / 1; position: relative; }
  .quad {
    position: absolute;
    inset: 12px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 8px;
  }
  .quad img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 6px;
    transition: transform 0.18s ease;
  }
  .collage:hover .quad img { transform: scale(1.03); }
  .t {
    padding: 10px 12px 12px;
    min-height: 58px;
    font-family: var(--sans);
    color: var(--ink);
    font-size: 13px;
    line-height: 1.4;
    border-top: 1px solid var(--hair);
  }
  .t strong { display: block; font-weight: 600; }
  .b { display: block; color: var(--dim); font-size: 12px; margin-top: 2px; }
</style>
