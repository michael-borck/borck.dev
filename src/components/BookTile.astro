---
import type { Book } from '../data/wall.ts';
interface Props {
  book: Book;
  href?: string;
}
const { book, href } = Astro.props;
const link = href ?? book.href ?? 'https://books.borck.education/';
const badges: Record<string, { text: string; kind: string }> = {
  references: { text: 'FREE', kind: 'free' },
  experimental: { text: 'IN DEV', kind: 'wip' },
};
const badge = badges[book.tier];
---

<a class="book" href={link} data-slug={book.slug} style={`--cover-bg:${book.bg ?? 'var(--card2)'}`}>
  {badge && <span class={`badge ${badge.kind}`}>{badge.text}</span>}
  <img src={`/tiles/covers/${book.slug}.webp`} alt={book.title} loading="lazy" />
  {book.parent && <div class="tagrow"><span class="thtag parent">extends {book.parent}</span></div>}
  <div class="t">
    <strong>{book.title}</strong>
    {book.blurb && <span class="b">{book.blurb}</span>}
  </div>
</a>

<style>
  * { box-sizing: border-box; }
  .book {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--card2);
    border: 1px solid var(--hair);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .book:hover {
    transform: translateY(-4px);
    border-color: var(--acc);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.5);
  }
  img {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    padding: 12px;
    background: var(--cover-bg);
  }
  .badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--acc);
    color: var(--bg);
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 6px;
    letter-spacing: 0.06em;
    z-index: 1;
  }
  .badge.free { background: var(--green); }
  .badge.wip { background: transparent; color: var(--red); border: 1px solid var(--red); }
  .tagrow { position: absolute; bottom: 64px; left: 10px; display: flex; gap: 5px; flex-wrap: wrap; }
  .thtag {
    font-family: var(--mono);
    font-size: 9.5px;
    letter-spacing: 0.05em;
    background: rgba(5, 6, 8, 0.82);
    color: var(--dim);
    padding: 2px 7px;
    border-radius: 5px;
    text-transform: uppercase;
  }
  .thtag.parent { color: var(--acc); }
  .t {
    padding: 10px 12px 12px;
    min-height: 58px;
    font-family: var(--sans);
    color: var(--ink);
    font-size: 13px;
    line-height: 1.4;
  }
  .t strong { display: block; font-weight: 600; }
  .b { display: block; color: var(--dim); font-size: 12px; margin-top: 2px; }
</style>
