---
interface Props {
  frames: string[];
  title: string;
  blurb?: string;
  href: string;
  delay?: number;
  period?: number;
  mode?: 'fade' | 'kenburns';
  zoom?: number;
}
const { frames, title, blurb, href, delay = 0, period = 12, mode = 'fade', zoom = 1.14 } = Astro.props;
---

<a class="retro" href={href} aria-label={title}>
  <div class="face">
    {mode === 'kenburns' ? (
      <img class="kb" src={`/tiles/${frames[0]}`} alt="" style={`animation-duration:${period}s;animation-delay:-${delay}s;--kb-to:${zoom}`} />
    ) : (
      <div class="stack">
        {frames.map((f, i) => <img src={`/tiles/${f}`} alt="" style={`animation:xfade ${period}s infinite;animation-delay:${i * (period / 3) + delay}s`} />)}
      </div>
    )}
  </div>
  <div class="t">
    <strong>{title}</strong>
    {blurb && <span class="b">{blurb}</span>}
  </div>
</a>

<style>
  * { box-sizing: border-box; }
  .retro {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--card2);
    border: 1px solid var(--hair);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .retro:hover { transform: translateY(-4px); border-color: var(--acc); box-shadow: 0 10px 24px rgba(0, 0, 0, 0.5); }
  .face { aspect-ratio: 1 / 1; position: relative; overflow: hidden; }
  .stack { position: absolute; inset: 0; }
  .stack img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }
  .t {
    padding: 10px 12px 12px;
    min-height: 58px;
    font-family: var(--sans);
    color: var(--ink);
    font-size: 13px;
    line-height: 1.4;
    border-top: 1px solid var(--hair);
  }
  .t strong { display: block; font-weight: 600; }
  .b { display: block; color: var(--dim); font-size: 12px; margin-top: 2px; }
  @keyframes xfade {
    0% { opacity: 0; } 4% { opacity: 1; } 30% { opacity: 1; } 37% { opacity: 0; } 100% { opacity: 0; }
  }
  .kb {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation-name: kenburns;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-direction: alternate;
  }
  @keyframes kenburns {
    from { transform: scale(calc(var(--kb-to) * 0.91)) translate(0, 0); }
    to { transform: scale(var(--kb-to)) translate(-1.8%, 1.5%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .stack img { animation: none; opacity: 1; }
    .stack img + img { opacity: 0; }
    .kb { animation: none; }
  }
</style>
