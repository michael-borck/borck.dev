---
import '../styles/tokens.css';
import { wall, bookHref, type Book } from '../data/wall.ts';
import BookTile from '../components/BookTile.astro';
import CollageTile from '../components/CollageTile.astro';
import ArtTile from '../components/ArtTile.astro';
import RetroTile from '../components/RetroTile.astro';

const bySlug = Object.fromEntries(wall.books.map((b) => [b.slug, b]));
const flagships = (wall.books_wall?.flagships ?? []).map((s) => bySlug[s]).filter(Boolean) as Book[];
const collageBooks = (wall.books_wall?.collage.slugs ?? []).map((s) => bySlug[s]).filter(Boolean) as Book[];
const collage = wall.books_wall?.collage;

// stable per-tile timing so shelves never pulse in lockstep
const hash = (str) => [...str].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7);
const timedGroups = wall.groups.map((g) => ({
  ...g,
  tiles: g.tiles.map((t, i) => ({
    ...t,
    period: t.kenburns ? 22 + (hash(t.title) % 12) : 11 + (hash(t.title) % 6),
    delay: (hash(g.id + t.title) % 9) + i * 2,
  })),
}));

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://borck.dev/#michael-borck',
  name: 'Michael Borck',
  givenName: 'Michael',
  familyName: 'Borck',
  url: 'https://borck.dev',
  jobTitle: 'Lecturer & AI Facilitator',
  worksFor: {
    '@type': 'CollegeOrUniversity',
    name: 'Curtin University',
    department: 'School of Marketing and Management, Faculty of Business and Law',
  },
  knowsAbout: [
    'AI in education', 'privacy-first AI', 'local language models',
    'assessment design', 'educational technology', 'work-integrated learning',
  ],
  sameAs: [
    'https://bigpicture.borck.dev',
    'https://borck.education',
    'https://tools.borck.education',
    'https://books.borck.education',
    'https://research.borck.dev',
    'https://resume.borck.dev',
    'https://locolabo.org',
    'https://locoensayo.org',
    'https://retroverse.studio',
    'https://conversationnotdelegation.com',
    'https://github.com/michael-borck',
    'https://www.linkedin.com/in/michaelborck',
    'https://orcid.org/0000-0002-0950-6396',
    'https://scholar.google.com/citations?user=fwNMowoAAAAJ&hl=en',
    'https://www.researchgate.net/profile/Michael-Borck',
    'https://curtin.academia.edu/MichaelBorck',
    'https://x.com/Michael_Borck',
    'https://www.youtube.com/@8020workshop',
    'https://about.me/michaelborck',
    'https://www.facebook.com/michael.borck/',
  ],
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Michael Borck</title>
    <meta name="description" content="Builder, educator, researcher, and consultant — helping people work with AI, not around it." />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Domine:wght@400;600&family=Funnel+Sans:wght@400;600&family=Nanum+Gothic+Coding:wght@400;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="corner" href="/">borck<span class="tld">.dev</span></a>

    <main>
      <header class="masthead">
        <h1 class="name">Michael<br /><span class="surname">Borck</span></h1>
        <p class="thesis">
          Builder, educator, researcher, and consultant — one thesis in four registers:
          books, tools, research, and consulting, all helping people work with AI, not around it.
        </p>
      </header>

      <section class="group" id="books">
        <div class="group-head">
          <h2>Books &amp; Writing</h2>
          <span class="count">{wall.books.length} works &middot; {wall.books.filter((b) => b.tier === 'books').length} books</span>
          <span class="blurb">most hang off the first two</span>
        </div>
        <div class="grid card-grid">
          {flagships.map((b) => <BookTile book={b} href={bookHref(b)} />)}
          {collage && collageBooks.length > 0 && (
            <CollageTile
              items={collageBooks.map((b) => ({ img: `/tiles/covers/${b.slug}.webp`, bg: b.bg, alt: b.title }))}
              title={collage.title}
              blurb={collage.blurb}
              href={collage.href}
            />
          )}
        </div>
      </section>

      {timedGroups.map((g) => (
        <section class="group" id={g.id}>
          <div class="group-head">
            <h2>{g.label}</h2>
            <span class="count">{g.tiles.length + (g.collage ? 1 : 0) + (g.animated ? 1 : 0)}</span>
            <span class="blurb">{g.blurb}</span>
          </div>
          {(g.tiles.length > 0 || g.animated) && (
            <div class="grid card-grid">
              {g.collage && (
                <CollageTile
                  items={g.collage.images.map((img) => ({ img: `/tiles/${img}` }))}
                  title={g.collage.title}
                  blurb={g.collage.blurb}
                  href={g.href}
                />
              )}
              {g.animated && (
                <div class="play-cell">
                  <RetroTile frames={g.animated.frames} title={g.animated.title} blurb={g.animated.blurb} href={g.href} />
                </div>
              )}
              {g.tiles.map((t, i) => (
                (t.frames || t.kenburns) ? (
                  <RetroTile
                    frames={t.frames ?? [t.img].filter(Boolean)}
                    delay={i * 4}
                    mode={t.kenburns ? 'kenburns' : 'fade'}
                    period={t.period}
                    delay={t.delay}
                    zoom={t.zoom}
                    title={t.title}
                    blurb={t.blurb}
                    href={t.href ?? g.href}
                  />
                ) : (
                  <ArtTile
                    img={t.img}
                    title={t.title}
                    blurb={t.blurb}
                    href={t.href ?? (g.animated ? undefined : g.href)}
                    tags={g.id === 'tools' ? ['education'] : g.id === 'research' ? ['research'] : []}
                  />
                )
              ))}
            </div>
          )}
        </section>
      ))}
    </main>

    <footer>
      <div class="pill-row">
        <a class="pill" href="https://scholar.google.com/citations?user=fwNMowoAAAAJ&hl=en">Google Scholar</a>
        <a class="pill" href="https://orcid.org/0000-0002-0950-6396">ORCID</a>
        <a class="pill" href="https://www.researchgate.net/profile/Michael-Borck">ResearchGate</a>
        <a class="pill" href="https://curtin.academia.edu/MichaelBorck">Academia</a>
        <a class="pill" href="https://www.linkedin.com/in/michaelborck">LinkedIn</a>
        <a class="pill" href="https://github.com/michael-borck">GitHub</a>
        <a class="pill" href="https://x.com/Michael_Borck">X</a>
        <a class="pill" href="https://www.youtube.com/@8020workshop">YouTube</a>
        <a class="pill" href="https://www.facebook.com/michael.borck/">Facebook</a>
        <a class="pill" href="https://about.me/michaelborck">about.me</a>
      </div>
      <div class="footer-links">
        <a href="https://books.borck.education">Books</a>
        <a href="https://tools.borck.education">Tools</a>
        <a href="https://research.borck.dev">Research</a>
        <a href="https://locolabo.org">Lab</a>
        <a href="https://simulations.borck.education">Simulations</a>
        <a href="https://teach.borck.education">Teaching</a>
        <a href="https://borck.consulting">Consulting</a>
        <a href="https://deck-engine.borck.dev">Deck engine</a>
        <a href="https://borck.consulting/decks/">Card decks</a>
        <a href="https://resume.borck.dev">Resume</a>
        <a href="https://retroverse.studio">Play</a>
        <a href="https://bigpicture.borck.dev">Big picture</a>
        <a href="https://borck.education">Education</a>
      </div>
      <p>Michael Borck · Perth, WA · <a href="mailto:hello@borck.dev">hello@borck.dev</a></p>
    </footer>
  




</body>
</html>

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--stage-bg);
    color: var(--ink);
    font-family: var(--sans);
    padding: 48px 24px 96px;
  }
  main, footer { max-width: 1160px; margin: 0 auto; }
  a { color: var(--acc); }

  .corner {
    position: fixed;
    top: 20px;
    left: 24px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--dim);
    text-decoration: none;
    z-index: 5;
  }
  .corner .tld { color: var(--acc); }

  .masthead { padding: 72px 0 24px; }
  .name {
    font-family: var(--serif);
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.05;
  }
  .surname { color: var(--acc); }
  .thesis { color: var(--dim); max-width: 640px; line-height: 1.55; margin-top: 18px; }

  .group { margin-top: 64px; }
  .group-head { display: flex; align-items: baseline; gap: 14px; margin-bottom: 18px; flex-wrap: wrap; }
  .group-head h2 { font-family: var(--serif); font-size: 24px; font-weight: 600; }
  .group-head .count { font-family: var(--mono); font-size: 11.5px; color: var(--faint); }
  .group-head .blurb { font-size: 13px; color: var(--dim); margin-left: auto; text-align: right; }

  .card-grid { display: grid; gap: var(--gap); grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
  .card-grid > * { min-width: 0; }
  .play-row { margin-top: var(--gap); }

  footer { margin-top: 88px; }
  .pill-row { display: flex; flex-wrap: wrap; gap: 8px; border-top: 1px solid var(--hair); padding-top: 24px; margin-bottom: 14px; }
  .pill {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--dim);
    text-decoration: none;
    border: 1px solid var(--hair);
    border-radius: 999px;
    padding: 4px 12px;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .pill:hover { color: var(--acc); border-color: var(--acc); }
  .footer-links { display: flex; flex-wrap: wrap; gap: 18px; font-family: var(--mono); font-size: 12.5px; }
  .footer-links a { color: var(--dim); text-decoration: none; }
  .footer-links a:hover { color: var(--acc); }
  footer p { color: var(--faint); font-size: 13px; margin-top: 16px; }
</style>
